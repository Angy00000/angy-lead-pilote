# Copier en .env.local — ne jamais commiter de vraies valeurs.
# En production, ces variables sont définies uniquement dans Vercel.

# Neon — rôle applicatif angy_lp_web UNIQUEMENT (jamais angy_lp_owner).
# Branche "dev" en local, "main" en production.
DATABASE_URL=postgresql://angy_lp_web:<mot_de_passe>@<hote-pooler>.neon.tech/angy_lp?sslmode=require

# Neon Auth (Better Auth) — URL de la branche (Console : Auth > Configuration)
NEON_AUTH_BASE_URL=

# Secret de chiffrement des cookies de session (32 caractères min.)
# Générer avec : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
