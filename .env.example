# Copier en .env.local — ne jamais commiter de vraies valeurs.

# Neon — rôle applicatif angy_lp_web UNIQUEMENT (jamais angy_lp_owner ni angy_lp_app).
# Branche "dev" en local, "main" en production (variables Vercel).
DATABASE_URL=postgresql://angy_lp_web:<mot_de_passe>@<hote-pooler>.neon.tech/angy_lp?sslmode=require

# Neon Auth (Better Auth) — URL publique de la branche
NEON_AUTH_BASE_URL=
